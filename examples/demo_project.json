            {
              "type": "else",
              "onTrue": [
                {
                  "#comment": "resolve led id -> tempVars[0]",
                  "type": "command",
                  "componentType": "led",
                  "componentIdArg": 0,
                  "commandId": 0,
                  "retArg": {
                    "tempVarIndex": 0
                  }
