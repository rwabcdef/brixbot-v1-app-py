        "condVars": [
          {
            "#comment": "button A pressed",
            "type": "command",
            "componentType": "button",
            "componentId": "A",
            "commandId": 1
          },
          {
            "#comment": "press count",
            "type": "global",
            "globalVariableIndex": 0
          }
        ],
        "conditionBlock": {
          "conditionGroups": [
            {
              "type": "if",
              "conditions": [
                {
                  "leftVar": {
                    "condVarIndex": 0
                  },
                  "operator": "equal",
                  "rightFixedVal": {
                    "type": "bool",
                    "value": true
                  }
                },
                {
                  "leftVar": {
                    "condVarIndex": 1
                  },
                  "operator": "greaterthanorequal",
                  "rightFixedVal": {
                    "type": "uint16",
                    "value": 3
                  }
                }
              ],
              "connectors": [
                "and"
